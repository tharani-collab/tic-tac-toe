{
  "name": "tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "description": "Tic Tac Toe game built with HTML, JavaScript and Tailwind CSS v4",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./output.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./output.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
